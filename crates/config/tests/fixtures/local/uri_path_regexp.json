{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":9080"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "rewrite",
                  "path_regexp": [
                    {
                      "find": "^/old/(.*)$",
                      "replace": "/new/$1"
                    }
                  ]
                },
                {
                  "body": "ok",
                  "handler": "static_response"
                }
              ]
            }
          ]
        }
      }
    }
  }
}

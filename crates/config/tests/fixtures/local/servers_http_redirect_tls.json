{
    "apps": {
        "http": {
            "servers": {
                "srv0": {
                    "listen": [
                        ":8080"
                    ],
                    "listener_wrappers": [
                        {
                            "wrapper": "http_redirect"
                        },
                        {
                            "wrapper": "tls"
                        }
                    ],
                    "routes": [
                        {
                            "handle": [
                                {
                                    "body": "ok",
                                    "handler": "static_response"
                                }
                            ]
                        }
                    ]
                }
            }
        }
    }
}

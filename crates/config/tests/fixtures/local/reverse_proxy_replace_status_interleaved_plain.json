{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":8080"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handle_response": [
                    {
                      "status_code": 404
                    },
                    {
                      "status_code": 500
                    },
                    {
                      "routes": [
                        {
                          "handle": [
                            {
                              "body": "first",
                              "handler": "static_response"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "routes": [
                        {
                          "handle": [
                            {
                              "body": "second",
                              "handler": "static_response"
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "localhost:9000"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
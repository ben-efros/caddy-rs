{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":9080"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "rewrite",
                  "uri_substring": [
                    {
                      "find": "foo",
                      "replace": "bar"
                    }
                  ]
                },
                {
                  "handler": "rewrite",
                  "uri_substring": [
                    {
                      "find": "a",
                      "limit": 3,
                      "replace": "b"
                    }
                  ]
                },
                {
                  "handler": "rewrite",
                  "uri_substring": [
                    {
                      "find": "/old/",
                      "replace": "/new/"
                    }
                  ]
                },
                {
                  "body": "ok",
                  "handler": "static_response"
                }
              ]
            }
          ]
        }
      }
    }
  }
}

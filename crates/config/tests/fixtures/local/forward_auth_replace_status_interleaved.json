{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":8080"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handle_response": [
                    {
                      "match": {
                        "status_code": [
                          2
                        ]
                      },
                      "routes": [
                        {
                          "handle": [
                            {
                              "handler": "vars"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "match": {
                        "status_code": [
                          2
                        ]
                      },
                      "routes": [
                        {
                          "handle": [
                            {
                              "body": "ok",
                              "handler": "static_response"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "status_code": 403
                    },
                    {
                      "routes": [
                        {
                          "handle": [
                            {
                              "body": "denied",
                              "handler": "static_response",
                              "status_code": 401
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "handler": "reverse_proxy",
                  "headers": {
                    "request": {
                      "set": {
                        "X-Forwarded-Method": [
                          "{http.request.method}"
                        ],
                        "X-Forwarded-Uri": [
                          "{http.request.uri}"
                        ]
                      }
                    }
                  },
                  "rewrite": {
                    "method": "GET",
                    "uri": "/auth"
                  },
                  "upstreams": [
                    {
                      "dial": "auth:9091"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
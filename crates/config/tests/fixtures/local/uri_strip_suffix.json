{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":9080"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "rewrite",
                  "strip_path_suffix": ".html"
                },
                {
                  "body": "ok",
                  "handler": "static_response"
                }
              ]
            }
          ]
        }
      }
    }
  }
}

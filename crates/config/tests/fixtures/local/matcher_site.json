{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":8081"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "localhost:9000"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "path": [
                    "/api/*"
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}

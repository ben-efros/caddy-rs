                  "upstreams": [
                    {
                      "dial": "10.0.0.53:53"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "srv2": {
          "listen": [
            "0.0.0.0:853/udp"
          ],
          "routes": [
            {

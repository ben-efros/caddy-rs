{
  "apps": {
    "layer4": {
      "servers": {
        "srv0": {
          "listen": [
            "0.0.0.0:8443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "client_auth": {
                    "mode": "request",
                    "trusted_ca_cert_file": [
                      "/etc/ca/a.pem",
                      "/etc/ca/b.pem"
                    ]
                  },
                  "handler": "tls"
                },
                {
                  "handler": "proxy_protocol"
                },
                {
                  "downstream_bytes_per_second": 52428800,
                  "handler": "throttle",
                  "upstream_bytes_per_second": 10000000
                },
                {
                  "handler": "proxy",
                  "upstreams": [
                    {
                      "dial": "10.0.0.1:8443"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "tls": {}
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "http",
                  "tls": false
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "close"
                }
              ]
            }
          ]
        }
      }
    }
  }
}

{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "example.com"
                  ]
                }
              ],
              "terminal": true
            }
          ],
          "errors": {
            "routes": [
              {
                "match": [
                  {
                    "host": [
                      "example.com"
                    ]
                  }
                ],
                "handle": [
                  {
                    "handler": "subroute",
                    "routes": [
                      {
                        "handle": [
                          {
                            "handler": "subroute",
                            "routes": [
                              {
                                "handle": [
                                  {
                                    "handle_response": [
                                      {
                                        "routes": [
                                          {
                                            "handle": [
                                              {
                                                "handler": "vars",
                                                "log_skip": true
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ],
                                    "handler": "reverse_proxy",
                                    "upstreams": [
                                      {
                                        "dial": "localhost:9000"
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ],
                "terminal": true
              }
            ]
          }
        }
      }
    }
  }
}
